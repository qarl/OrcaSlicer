#usda 1.0
(
    metersPerUnit = 0.001
    upAxis = "Z"
)

# A subdivision cube carrying an OSL displacement shader, bound the way USD models shading: a UsdShade
# Material whose `displacement` terminal connects to a Shader prim naming the OSL shader (info:id). The
# declared bound is an input on that shader: inputs:maxMagnitude (mm) grows the slice band so the relief is
# not clipped. printman_grid = the built-in Gridwork. The slicer displaces the refined surface by that shader.
def Mesh "cube" (
    prepend apiSchemas = ["MaterialBindingAPI"]
)
{
    int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
    int[] faceVertexIndices = [0, 3, 2, 1, 4, 5, 6, 7, 0, 1, 5, 4, 2, 3, 7, 6, 1, 2, 6, 5, 3, 0, 4, 7]
    point3f[] points = [(-5, -5, 0), (5, -5, 0), (5, 5, 0), (-5, 5, 0), (-5, -5, 10), (5, -5, 10), (5, 5, 10), (-5, 5, 10)]
    uniform token subdivisionScheme = "catmullClark"
    rel material:binding = </cube/Material>

    def Material "Material"
    {
        token outputs:displacement.connect = </cube/Material/Displacement.outputs:out>

        def Shader "Displacement"
        {
            uniform token info:id = "printman_grid"
            float inputs:printman:maxMagnitude = 0.7875
            token outputs:out
        }
    }
}
