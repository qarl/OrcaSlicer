#usda 1.0
(
    metersPerUnit = 0.001
    upAxis = "Z"
)

# A catmullClark cube prototype instanced three times, one instance rotated so the amplified
# (per-placement Z-slab) path must match the naive (flattened, eagerly refined) path under a tilt.
def "Prototypes"
{
    class Xform "Proto"
    {
        def Mesh "Cube"
        {
            int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
            int[] faceVertexIndices = [0, 3, 2, 1, 4, 5, 6, 7, 0, 1, 5, 4, 1, 2, 6, 5, 2, 3, 7, 6, 3, 0, 4, 7]
            point3f[] points = [(0, 0, 0), (30, 0, 0), (30, 30, 0), (0, 30, 0), (0, 0, 30), (30, 0, 30), (30, 30, 30), (0, 30, 30)]
            uniform token subdivisionScheme = "catmullClark"
        }
    }
}

def "Root"
{
    def Xform "inst_000" (
        prepend inherits = </Prototypes/Proto>
        instanceable = true
    )
    {
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Xform "inst_001" (
        prepend inherits = </Prototypes/Proto>
        instanceable = true
    )
    {
        double3 xformOp:translate = (60, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Xform "inst_002" (
        prepend inherits = </Prototypes/Proto>
        instanceable = true
    )
    {
        double3 xformOp:translate = (120, 20, 15)
        float3 xformOp:rotateXYZ = (25, 18, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }
}
