#usda 1.0
(
    metersPerUnit = 0.001
    upAxis = "Z"
)

# A tall box carrying a full-spectrum surface-colour shader dithered across EVERY loaded filament.
# It is a catmullClark cage (the colour/amplification path only attaches to subdivision cages), but every
# edge and corner is creased infinitely sharp, so the limit surface is the box itself rather than the rounded
# blob a bare cube subdivides into -- the gradient then spans the full height with a flat base, so the very
# bottom of the sweep (cyan) gets real wall instead of being eaten by a rounded taper.
# printman:colorAllFilaments paints with the whole loaded palette (not a fixed pair); printman:colorObjectSpace
# normalizes the hue sweep in Z so it spans the object; printman:colorDither blends each height across the two
# nearest filaments. Load several distinct filaments to see the effect.
def Mesh "cube"
{
    int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
    int[] faceVertexIndices = [0, 3, 2, 1, 4, 5, 6, 7, 0, 1, 5, 4, 2, 3, 7, 6, 1, 2, 6, 5, 3, 0, 4, 7]
    point3f[] points = [(-10, -10, 0), (10, -10, 0), (10, 10, 0), (-10, 10, 0), (-10, -10, 40), (10, -10, 40), (10, 10, 40), (-10, 10, 40)]
    uniform token subdivisionScheme = "catmullClark"
    int[] creaseIndices = [0, 1, 1, 2, 2, 3, 3, 0, 4, 5, 5, 6, 6, 7, 7, 4, 0, 4, 1, 5, 2, 6, 3, 7]
    int[] creaseLengths = [2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2]
    float[] creaseSharpnesses = [10, 10, 10, 10, 10, 10, 10, 10, 10, 10, 10, 10]
    int[] cornerIndices = [0, 1, 2, 3, 4, 5, 6, 7]
    float[] cornerSharpnesses = [10, 10, 10, 10, 10, 10, 10, 10]
    custom string printman:oslShader = "printman_spectrum"
    custom bool printman:colorObjectSpace = true
    custom bool printman:colorDither = true
    custom bool printman:colorAllFilaments = true
}
