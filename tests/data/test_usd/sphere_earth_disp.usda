#usda 1.0
(
    metersPerUnit = 0.001
    upAxis = "Z"
)

# A low-res UV-sphere Catmull-Clark cage carrying an authored equirectangular texture (Earth). primvars:st is
# FACE-VARYING (one (u,v) per face-corner), so the longitude seam is authored with u=1 on the wrap side and
# u=0 on the other -- a watertight sphere whose UV still splits cleanly at the seam. The slicer refines both
# the surface and the UV, then the bound surface shader samples earth.tx at the refined UV.
def Mesh "sphere" (
    prepend apiSchemas = ["MaterialBindingAPI"]
)
